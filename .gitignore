# Build outputs (never commit — see shared/rules/50-git-workflow.md)
build/
# ...except the build tool itself, which lives at mcu/tools/build/ and is source.
!mcu/tools/build/
!mcu/tools/build/**
builds/
output/
tmp/
sstate-cache/
downloads/
deploy/
*.elf
*.bin
*.hex
*.img
*.wic
*.wic.gz
*.dtb
*.dtbo
*.map
*.o
*.a
*.ko

# Generated configs (commit the source: defconfig, prj.conf, .ioc)
.config
.config.old
*.tsbuildinfo

# Zephyr / west
.west/
zephyr/
modules/
bootloader/

# ESP-IDF
sdkconfig.old
managed_components/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.vscode/
!.vscode/extensions.json
.idea/
*.swp
.DS_Store

# Logs and captures
*.log
!**/reference/*.log
boot-*.log
session-*.log

# Local workflow state is stored under .antness/.

# Machine-local tool configuration and run state.
# project.json IS versioned — it is the team's shared hardware context.
.antness/local.json
.antness/state.json
.antness/implementation.json
