#!/usr/bin/env bash
# Git pre-commit hook. Install with:
#   ln -sf ../../.ai/hooks/pre-commit .git/hooks/pre-commit
set -uo pipefail
HOOKS="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM)
[ ${#files[@]} -gt 0 ] || exit 0

fail=0
"$HOOKS/secret-scan.sh" "${files[@]}" || fail=1
"$HOOKS/embedded-quality-gate.sh" "${files[@]}" || fail=1

# Reject build artifacts
for f in "${files[@]}"; do
  case "$f" in
    build/*|*/build/*|tmp/*|*/tmp/*|output/*|sstate-cache/*|*.elf|*.bin|*.wic|*.img|*.dtb|.config)
      echo "[FAIL] $f: build artifact must not be committed"; fail=1 ;;
  esac
done

exit $fail
