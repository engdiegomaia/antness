{
  "_comment": "Example Claude Code hook configuration. Merge into .claude/settings.json in the target project. Paths assume the install placed hooks at .ai/hooks/.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".ai/hooks/guard-destructive-hardware.sh",
            "description": "Block irreversible hardware operations"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".ai/hooks/embedded-quality-gate.sh \"$CLAUDE_FILE_PATHS\"",
            "description": "Format/lint embedded sources after edits"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".ai/hooks/secret-scan.sh",
            "description": "Scan staged changes for credentials before the session ends"
          }
        ]
      }
    ]
  }
}
